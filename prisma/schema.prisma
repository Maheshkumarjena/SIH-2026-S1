generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  student
  staff
  admin
  warden
  lab_incharge
}

enum RiskLevel {
  low
  medium
  high
}

enum WorkflowStepStatus {
  pending
  executing
  done
  awaiting_approval
  failed
  rejected
  info_requested
}

enum ApprovalDecision {
  approved
  rejected
  info_requested
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  email             String               @unique
  passwordHash      String               @map("password_hash")
  role              RoleName
  departmentId      String               @map("department_id") @db.Uuid
  preferredLanguage String               @default("en") @map("preferred_language")
  notificationPrefs Json                 @default("{}") @map("notification_prefs")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  department        Department           @relation("DepartmentUsers", fields: [departmentId], references: [id])
  hodDepartments    Department[]         @relation("DepartmentHod")
  student           Student?
  faculty           Faculty?
  sessions          AgentSession[]
  requests          ServiceRequest[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  certificates      Certificate[]
  seminarBookings   SeminarHallBooking[]
  wardenAllocations HostelAllocation[]   @relation("WardenAllocations")

  @@map("users")
}

model Department {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  code         String        @unique
  type         String        // academic | hostel | lab | administrative
  hodUserId    String?       @map("hod_user_id") @db.Uuid
  hodUser      User?         @relation("DepartmentHod", fields: [hodUserId], references: [id])
  users        User[]        @relation("DepartmentUsers")
  sections     Section[]
  faculty      Faculty[]
  subjects     Subject[]
  labResources LabResource[]
  seminarHalls SeminarHall[]
  feeStructures FeeStructure[]

  @@map("departments")
}

model Section {
  id             String                  @id @default(uuid()) @db.Uuid
  departmentId   String                  @map("department_id") @db.Uuid
  name           String
  year           Int
  semester       Int
  batchLabel     String                  @map("batch_label")
  classTeacherId String?                 @map("class_teacher_id") @db.Uuid
  strength       Int
  department     Department              @relation(fields: [departmentId], references: [id])
  classTeacher   Faculty?                @relation("ClassTeacher", fields: [classTeacherId], references: [userId])
  students       Student[]
  labBookings    LabBooking[]
  subjectLinks   SectionSubjectFaculty[]

  @@map("sections")
}

model Student {
  userId           String             @id @map("user_id") @db.Uuid
  registrationNo   String             @unique @map("registration_no")
  rollNo           String             @map("roll_no")
  sectionId        String             @map("section_id") @db.Uuid
  admissionYear    Int                @map("admission_year")
  status           String             @default("active")
  guardianName     String?            @map("guardian_name")
  guardianPhone    String?            @map("guardian_phone")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  section          Section            @relation(fields: [sectionId], references: [id])
  examRecords      ExamRecord[]
  feePayments      FeePayment[]
  hostelAllocations HostelAllocation[]
  libraryRecords   LibraryRecord[]

  @@map("students")
}

model Faculty {
  userId               String                  @id @map("user_id") @db.Uuid
  employeeId           String                  @unique @map("employee_id")
  departmentId         String                  @map("department_id") @db.Uuid
  designation          String
  isLabIncharge        Boolean                 @default(false) @map("is_lab_incharge")
  isHod                Boolean                 @default(false) @map("is_hod")
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department           Department              @relation(fields: [departmentId], references: [id])
  classTeacherSections Section[]               @relation("ClassTeacher")
  subjectLinks         SectionSubjectFaculty[]
  inchargeLabs         LabResource[]           @relation("LabIncharge")

  @@map("faculty")
}

model Subject {
  id           String                  @id @default(uuid()) @db.Uuid
  departmentId String                  @map("department_id") @db.Uuid
  code         String                  @unique
  name         String
  semester     Int
  requiresLab  Boolean                 @default(false) @map("requires_lab")
  department   Department              @relation(fields: [departmentId], references: [id])
  sectionLinks SectionSubjectFaculty[]
  examRecords  ExamRecord[]

  @@map("subjects")
}

model SectionSubjectFaculty {
  id        String  @id @default(uuid()) @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  facultyId String  @map("faculty_id") @db.Uuid
  section   Section @relation(fields: [sectionId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  faculty   Faculty @relation(fields: [facultyId], references: [userId])

  @@unique([sectionId, subjectId, facultyId])
  @@map("section_subject_faculty")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id])

  @@unique([tokenHash])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model RequestType {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @unique
  defaultRiskLevel RiskLevel        @map("default_risk_level")
  defaultSlaHours  Int              @default(72) @map("default_sla_hours")
  requests         ServiceRequest[]

  @@map("request_types")
}

model ServiceRequest {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  sessionId     String?        @map("session_id") @db.Uuid
  requestTypeId String         @map("request_type_id") @db.Uuid
  departmentId  String?        @map("department_id") @db.Uuid
  status        String         @default("pending")
  description   String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  slaDueAt      DateTime       @map("sla_due_at") @db.Timestamptz
  resolvedAt    DateTime?      @map("resolved_at") @db.Timestamptz
  user          User           @relation(fields: [userId], references: [id])
  session       AgentSession?  @relation(fields: [sessionId], references: [id])
  requestType   RequestType    @relation(fields: [requestTypeId], references: [id])
  workflowSteps WorkflowStep[]
  certificates  Certificate[]

  @@index([userId, status])
  @@index([slaDueAt])
  @@map("service_requests")
}

model Certificate {
  id               String         @id @default(uuid()) @db.Uuid
  requestId        String         @map("request_id") @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  certificateType  String         @map("certificate_type")
  purpose          String
  status           String         @default("issued")
  serialNumber     String         @unique @map("serial_number")
  verificationCode String         @unique @map("verification_code")
  signedPayload    Json           @map("signed_payload")
  signature        String
  issuedBy         String         @map("issued_by") @db.Uuid
  issuedAt         DateTime       @default(now()) @map("issued_at") @db.Timestamptz
  request          ServiceRequest @relation(fields: [requestId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
  @@map("certificates")
}

model WorkflowStep {
  id             String             @id @default(uuid()) @db.Uuid
  requestId      String             @map("request_id") @db.Uuid
  sessionId      String             @map("session_id") @db.Uuid
  stepName       String             @map("step_name")
  toolName       String             @map("tool_name")
  toolArgs       Json               @map("tool_args")
  rationale      String
  riskLevel      RiskLevel          @map("risk_level")
  status         WorkflowStepStatus @default(pending)
  idempotencyKey String             @unique @map("idempotency_key")
  resultJson     Json?              @map("result_json")
  executedAt     DateTime?          @map("executed_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  request        ServiceRequest     @relation(fields: [requestId], references: [id])
  session        AgentSession       @relation(fields: [sessionId], references: [id])
  approvals      Approval[]

  @@index([requestId])
  @@index([sessionId])
  @@map("workflow_steps")
}

model Approval {
  id             String            @id @default(uuid()) @db.Uuid
  workflowStepId String            @map("workflow_step_id") @db.Uuid
  reviewerId     String?           @map("reviewer_id") @db.Uuid
  decision       ApprovalDecision?
  reason         String?
  question       String?
  contextJson    Json              @default("{}") @map("context_json")
  decidedAt      DateTime?         @map("decided_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  workflowStep   WorkflowStep      @relation(fields: [workflowStepId], references: [id])

  @@index([decision])
  @@map("approvals")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  actor       String
  payloadJson Json     @map("payload_json")
  prevHash    String   @map("prev_hash")
  entryHash   String   @map("entry_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model KnowledgeDocument {
  id            String          @id @default(uuid()) @db.Uuid
  title         String
  documentId    String          @map("document_id")
  version       String
  uploadedBy    String          @map("uploaded_by") @db.Uuid
  fileUrl       String?         @map("file_url")
  status        String          @default("active")
  effectiveDate DateTime?       @map("effective_date") @db.Date
  chunks        DocumentChunk[]

  @@unique([documentId, version])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id         String                 @id @default(uuid()) @db.Uuid
  documentId String                 @map("document_id") @db.Uuid
  content    String
  embedding  Unsupported("vector")?
  sourcePage Int?                   @map("source_page")
  clause     String?
  document   KnowledgeDocument      @relation(fields: [documentId], references: [id])

  @@map("document_chunks")
}

model AgentSession {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  startedAt DateTime         @default(now()) @map("started_at") @db.Timestamptz
  language  String           @default("en")
  stateJson Json?            @map("state_json")
  user      User             @relation(fields: [userId], references: [id])
  messages  AgentMessage[]
  requests  ServiceRequest[]
  steps     WorkflowStep[]

  @@index([userId])
  @@map("agent_sessions")
}

model AgentMessage {
  id              String       @id @default(uuid()) @db.Uuid
  sessionId       String       @map("session_id") @db.Uuid
  sender          String
  content         String
  confidenceScore Float?       @map("confidence_score")
  citedChunkIds   String[]     @map("cited_chunk_ids")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  session         AgentSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("agent_messages")
}

model PolicyConflictFlag {
  id          String   @id @default(uuid()) @db.Uuid
  docAId      String   @map("doc_a_id") @db.Uuid
  docAClause  String?  @map("doc_a_clause")
  docAVersion String   @map("doc_a_version")
  docBId      String   @map("doc_b_id") @db.Uuid
  docBClause  String?  @map("doc_b_clause")
  docBVersion String   @map("doc_b_version")
  raisedAt    DateTime @default(now()) @map("raised_at") @db.Timestamptz
  status      String   @default("open")

  @@map("policy_conflict_flags")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  readFlag  Boolean  @default(false) @map("read_flag")
  deepLink  String?  @map("deep_link")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, readFlag])
  @@map("notifications")
}

model LabResource {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  departmentId  String?      @map("department_id") @db.Uuid
  capacity      Int
  restrictions  String?
  labType       String       @default("programming") @map("lab_type")
  labInchargeId String?      @map("lab_incharge_id") @db.Uuid
  location      String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  labIncharge   Faculty?     @relation("LabIncharge", fields: [labInchargeId], references: [userId])
  bookings      LabBooking[]

  @@map("lab_resources")
}

model LabBooking {
  id         String       @id @default(uuid()) @db.Uuid
  resourceId String       @map("resource_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  sectionId  String?      @map("section_id") @db.Uuid
  startTime  DateTime     @map("start_time") @db.Timestamptz
  endTime    DateTime     @map("end_time") @db.Timestamptz
  status     String       @default("confirmed")
  courseCode String?      @map("course_code")
  facultyRef String?      @map("faculty_ref")
  resource   LabResource  @relation(fields: [resourceId], references: [id])
  section    Section?     @relation(fields: [sectionId], references: [id])

  @@index([resourceId, startTime])
  @@map("lab_bookings")
}

model SeminarHall {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  departmentId String?              @map("department_id") @db.Uuid
  capacity     Int
  hasProjector Boolean              @default(false) @map("has_projector")
  hasAc        Boolean              @default(false) @map("has_ac")
  location     String?
  department   Department?          @relation(fields: [departmentId], references: [id])
  bookings     SeminarHallBooking[]

  @@map("seminar_halls")
}

model SeminarHallBooking {
  id               String      @id @default(uuid()) @db.Uuid
  hallId           String      @map("hall_id") @db.Uuid
  bookedByUserId   String      @map("booked_by_user_id") @db.Uuid
  purpose          String
  startTime        DateTime    @map("start_time") @db.Timestamptz
  endTime          DateTime    @map("end_time") @db.Timestamptz
  status           String      @default("confirmed")
  approvalRequired Boolean     @default(false) @map("approval_required")
  hall             SeminarHall @relation(fields: [hallId], references: [id])
  bookedByUser     User        @relation(fields: [bookedByUserId], references: [id])

  @@index([hallId, startTime])
  @@map("seminar_hall_bookings")
}

model FeeStructure {
  id           String       @id @default(uuid()) @db.Uuid
  departmentId String       @map("department_id") @db.Uuid
  year         Int
  semester     Int
  tuitionFee   Decimal      @map("tuition_fee")
  hostelFee    Decimal?     @map("hostel_fee")
  examFee      Decimal      @map("exam_fee")
  dueDate      DateTime     @map("due_date") @db.Date
  department   Department   @relation(fields: [departmentId], references: [id])
  payments     FeePayment[]

  @@map("fee_structure")
}

model FeePayment {
  id             String       @id @default(uuid()) @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  feeStructureId String       @map("fee_structure_id") @db.Uuid
  amountPaid     Decimal      @map("amount_paid")
  paymentStatus  String       @map("payment_status")
  paymentDate    DateTime?    @map("payment_date") @db.Timestamptz
  receiptNo      String?      @unique @map("receipt_no")
  paymentMode    String?      @map("payment_mode")
  student        Student      @relation(fields: [studentId], references: [userId])
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@map("fee_payments")
}

model ExamRecord {
  id            String    @id @default(uuid()) @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  subjectId     String    @map("subject_id") @db.Uuid
  examType      String    @map("exam_type")
  marksObtained Decimal?  @map("marks_obtained")
  maxMarks      Decimal   @map("max_marks")
  status        String    @default("published")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  student       Student   @relation(fields: [studentId], references: [userId])
  subject       Subject   @relation(fields: [subjectId], references: [id])

  @@map("exam_records")
}

model HostelAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  hostelBlock String   @map("hostel_block")
  roomNo      String   @map("room_no")
  wardenId    String?  @map("warden_id") @db.Uuid
  status      String   @default("active")
  allocatedAt DateTime @map("allocated_at") @db.Date
  student     Student  @relation(fields: [studentId], references: [userId])
  warden      User?    @relation("WardenAllocations", fields: [wardenId], references: [id])

  @@map("hostel_allocations")
}

model LibraryRecord {
  id         String    @id @default(uuid()) @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  bookTitle  String    @map("book_title")
  issuedAt   DateTime  @map("issued_at") @db.Date
  dueDate    DateTime  @map("due_date") @db.Date
  returnedAt DateTime? @map("returned_at") @db.Date
  fineAmount Decimal   @default(0) @map("fine_amount")
  student    Student   @relation(fields: [studentId], references: [userId])

  @@map("library_records")
}

model Grievance {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  category        String
  description     String
  anonymous       Boolean  @default(false)
  status          String   @default("open")
  escalationLevel Int      @default(1) @map("escalation_level")
  slaDueAt        DateTime @map("sla_due_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([ownerUserId])
  @@index([status, escalationLevel])
  @@map("grievances")
}
